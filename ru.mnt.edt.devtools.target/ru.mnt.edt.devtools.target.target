<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<?pde version="3.8"?>
<!--
  Целевая платформа: модули рабочей установки 1C:EDT Start (по умолчанию «1C_EDT 2026.1»).
  Папку ~/.mnt-edt-target готовит скрипт tools/edt-target.sh из bundles.info установки —
  запускать один раз и после каждого обновления EDT.
  В Eclipse: открыть этот файл и нажать «Set as Active Target Platform».
-->
<target name="1C:EDT (установка EDT Start)" sequenceNumber="2">
  <locations>
    <location path="${env_var:HOME}/.mnt-edt-target" type="Directory"/>
  </locations>
  <environment>
    <os>macosx</os>
    <ws>cocoa</ws>
    <arch>x86_64</arch>
  </environment>
  <targetJRE path="org.eclipse.jdt.launching.JRE_CONTAINER/org.eclipse.jdt.internal.debug.ui.launcher.StandardVMType/JavaSE-17"/>
</target>
