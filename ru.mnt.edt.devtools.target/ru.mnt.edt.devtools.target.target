<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<?pde version="3.8"?>
<!--
  Целевая платформа: плагины установленного 1C:EDT.
  При переходе на другую версию EDT меняется только путь ниже.
  В Eclipse: открыть этот файл и нажать «Set as Active Target Platform».
-->
<target name="1C:EDT 2026.1.1" sequenceNumber="1">
  <locations>
    <location path="/Applications/1C/1CE/components/1c-edt-2026.1.1+1-x86_64/1cedt (2026.1.1+1).app/Contents/Eclipse" type="Directory"/>
  </locations>
  <environment>
    <os>macosx</os>
    <ws>cocoa</ws>
    <arch>x86_64</arch>
  </environment>
  <targetJRE path="org.eclipse.jdt.launching.JRE_CONTAINER/org.eclipse.jdt.internal.debug.ui.launcher.StandardVMType/JavaSE-17"/>
</target>
